{
  "name": "@yabbadabbadev/croupier",
  "version": "0.1.0",
  "description": "Deterministic multi-agent state-machine pipeline for frontend engineering",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "croupier": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE_SPEC.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.54",
    "@langchain/openai": "^0.4.4",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "execa": "^9.5.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "yaml": "^2.9.1"
  }
}
